## 🎬 Animation System

### Philosophy

Animations must feel **purposeful and precise** — like the instruments DDSE uses. No bouncy, playful, or decorative motion. Every animation serves to:
1. Direct attention to key content
2. Reveal information progressively (prevent overwhelm)
3. Reinforce the brand's precision and quality

### Library Setup (CDN — no npm required for these)

Add to every HTML `<head>`:

```html
<!-- GSAP Core + Plugins -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/TextPlugin.min.js"></script>

<!-- ScrollReveal -->
<script src="https://unpkg.com/scrollreveal@4.0.9/dist/scrollreveal.min.js"></script>
```

Register plugins in `animations.js`:
```javascript
gsap.registerPlugin(ScrollTrigger, TextPlugin);
```

---

### GSAP Animation Patterns

All animation code lives in `src/js/animations.js`. Import it at the bottom of every page's `<body>`.

#### 1. Hero Section — Entry Timeline

```javascript
// animations.js — Hero entry
function initHeroAnimation() {
  const tl = gsap.timeline({ delay: 0.2 });

  tl.from('.hero-badge', {
    opacity: 0, y: -20, duration: 0.6, ease: 'power3.out'
  })
  .from('.hero-title .line-1', {
    opacity: 0, y: 60, duration: 0.9, ease: 'power4.out'
  }, '-=0.3')
  .from('.hero-title .line-2', {
    opacity: 0, y: 60, duration: 0.9, ease: 'power4.out'
  }, '-=0.6')
  .from('.hero-subtitle', {
    opacity: 0, y: 30, duration: 0.7, ease: 'power3.out'
  }, '-=0.4')
  .from('.hero-cta-group', {
    opacity: 0, y: 20, duration: 0.6, ease: 'power3.out'
  }, '-=0.3')
  .from('.hero-stats-bar', {
    opacity: 0, y: 20, duration: 0.5, ease: 'power3.out'
  }, '-=0.2');
}
```

#### 2. Typing Effect — Hero Tagline

```javascript
// Typing effect using GSAP TextPlugin
function initTypingEffect() {
  const phrases = [
    'Digital Topographic Survey',
    'Road & Bridge Survey',
    'Sub-Soil Investigation',
    'Pile Integrity Testing'
  ];
  let i = 0;

  function typeNext() {
    gsap.to('.hero-typing-text', {
      duration: 1.5,
      text: { value: phrases[i % phrases.length], delimiter: '' },
      ease: 'none',
      onComplete: () => {
        gsap.delayedCall(2, () => {
          gsap.to('.hero-typing-text', {
            duration: 0.5,
            text: { value: '', delimiter: '' },
            ease: 'none',
            onComplete: () => { i++; typeNext(); }
          });
        });
      }
    });
  }
  typeNext();
}
```

#### 3. Animated Stats Counter

```javascript
// Stats numbers count up when they enter the viewport
function initCounterAnimation() {
  document.querySelectorAll('[data-counter]').forEach(el => {
    const target = parseInt(el.dataset.counter);
    const suffix = el.dataset.suffix || '';

    ScrollTrigger.create({
      trigger: el,
      start: 'top 80%',
      once: true,
      onEnter: () => {
        gsap.to({ val: 0 }, {
          val: target,
          duration: 2.5,
          ease: 'power2.out',
          onUpdate: function() {
            el.textContent = Math.round(this.targets()[0].val) + suffix;
          }
        });
      }
    });
  });
}
```

HTML usage:
```html
<span data-counter="10" data-suffix="+">0+</span>  <!-- Years -->
<span data-counter="500" data-suffix="+">0+</span> <!-- Projects -->
<span data-counter="15" data-suffix="">0</span>    <!-- Team -->
```

#### 4. Navbar Scroll Effect

```javascript
function initNavbarAnimation() {
  const navbar = document.querySelector('.navbar');

  ScrollTrigger.create({
    start: 'top -80',
    end: 99999,
    toggleClass: { className: 'navbar--scrolled', targets: navbar }
  });
}
```

CSS for scrolled navbar:
```css
.navbar--scrolled {
  background: var(--primary-700);
  backdrop-filter: blur(12px);
  box-shadow: var(--shadow-lg);
}
```

#### 5. Service Card Hover with GSAP

```javascript
function initCardHovers() {
  document.querySelectorAll('.service-card').forEach(card => {
    const icon = card.querySelector('.card-icon');
    const shine = card.querySelector('.card-shine');

    card.addEventListener('mouseenter', () => {
      gsap.to(icon, { scale: 1.15, rotate: 5, duration: 0.35, ease: 'back.out(2)' });
      gsap.to(card, { y: -6, duration: 0.35, ease: 'power2.out' });
      if (shine) gsap.to(shine, { opacity: 1, duration: 0.3 });
    });

    card.addEventListener('mouseleave', () => {
      gsap.to(icon, { scale: 1, rotate: 0, duration: 0.35, ease: 'power2.out' });
      gsap.to(card, { y: 0, duration: 0.35, ease: 'power2.out' });
      if (shine) gsap.to(shine, { opacity: 0, duration: 0.3 });
    });
  });
}
```

#### 6. Floating/Parallax Hero Elements

```javascript
function initParallax() {
  // Subtle parallax on hero background
  gsap.to('.hero-bg-layer', {
    yPercent: 30,
    ease: 'none',
    scrollTrigger: {
      trigger: '.hero',
      start: 'top top',
      end: 'bottom top',
      scrub: true
    }
  });

  // Floating survey equipment icons
  gsap.to('.hero-float-icon', {
    y: -20,
    duration: 3,
    ease: 'sine.inOut',
    repeat: -1,
    yoyo: true,
    stagger: { each: 0.5, from: 'random' }
  });
}
```

---

### ScrollReveal Patterns

ScrollReveal handles all scroll-triggered entrance animations for sections.

```javascript
// animations.js — ScrollReveal config
function initScrollReveal() {
  const sr = ScrollReveal({
    distance: '40px',
    duration: 800,
    easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
    reset: false,
    viewFactor: 0.15
  });

  // Fade up — default for most elements
  sr.reveal('.section-header', {
    origin: 'bottom', distance: '30px', duration: 700
  });

  // Cards — staggered entrance
  sr.reveal('.service-card', {
    origin: 'bottom', distance: '50px', duration: 800, interval: 120
  });

  sr.reveal('.team-card', {
    origin: 'bottom', distance: '40px', duration: 700, interval: 100
  });

  sr.reveal('.stat-item', {
    origin: 'bottom', distance: '30px', duration: 600, interval: 80
  });

  // Alternating left/right for feature rows
  sr.reveal('.feature-left', {
    origin: 'left', distance: '60px', duration: 900
  });

  sr.reveal('.feature-right', {
    origin: 'right', distance: '60px', duration: 900
  });

  // Image blocks
  sr.reveal('.reveal-img', {
    origin: 'bottom', distance: '30px', duration: 1000, scale: 0.96
  });
}
```

---

### Animation Init — Master Function

```javascript
// animations.js
document.addEventListener('DOMContentLoaded', () => {
  // GSAP
  initNavbarAnimation();
  initCardHovers();
  initCounterAnimation();
  initParallax();

  // Hero (only on index.html)
  if (document.querySelector('.hero')) {
    initHeroAnimation();
    initTypingEffect();
  }

  // ScrollReveal (all pages)
  initScrollReveal();
});
```

---

### Performance Rules for Animation

1. **Never animate layout properties** (`width`, `height`, `top`, `left`, `margin`). Animate only `transform` and `opacity` for 60fps performance.
2. **Add `will-change: transform`** to elements that will be animated with GSAP.
3. **Use `ScrollTrigger.matchMedia()`** to disable heavy animations on mobile:
   ```javascript
   ScrollTrigger.matchMedia({
     '(prefers-reduced-motion: reduce)': function() {
       ScrollTrigger.getAll().forEach(t => t.kill());
     }
   });
   ```
4. **Respect `prefers-reduced-motion`** — all GSAP timelines must check this before playing.
5. **Stagger delays** for card groups should not exceed 200ms per item (so 4 cards = max 800ms total delay).

